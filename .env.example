# FalkorDB Cloud connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=spine

# Groq API (free tier)
GROQ_API_KEY=

# Model routing
EXTRACTION_MODEL=llama-3.3-70b-versatile
ANSWER_MODEL=llama-3.3-70b-versatile
CONTRADICTION_MODEL=llama-3.1-8b-instant

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
